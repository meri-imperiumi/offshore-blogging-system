{
  "name": "@meri-imperiumi/signalk-offshore-blogging",
  "version": "0.2.2",
  "description": "Encode blog posts and weather requests for transmission via InReach or Winlink",
  "main": "plugin/index.js",
  "scripts": {
    "start": "node scripts/cloud-server.js",
    "lint": "npx @biomejs/biome check --use-editorconfig=true plugin/ public/ components/ lib/ scripts/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write plugin/ public/ components/ test/ lib/ scripts/",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "rns://adafb3153efd4d96d532568a5208b3b5/reticulum/offshore-blogging-system"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "signalk-webapp",
    "inreach",
    "offshore",
    "blogging"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "signalk": {
    "appIcon": "./icon.png",
    "displayName": "Offshore Blogging",
    "screenshots": [
      "./doc/weather-request.jpg",
      "./doc/download-grib.jpg"
    ]
  },
  "dependencies": {
    "@reticulum/core": "^0.6.5",
    "@reticulum/dacar": "^1.2.0",
    "imapflow": "^1.6.6",
    "noflo": "^1.5.2",
    "noflo-assembly": "^0.3.1",
    "noflo-core": "^0.6.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "noflo-wrapper": "^0.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
