{
  "name": "@meri-imperiumi/signalk-offshore-blogging",
  "version": "0.5.0",
  "description": "Encode blog posts and weather requests for transmission via InReach or Winlink",
  "type": "module",
  "main": "plugin/index.js",
  "scripts": {
    "start": "node scripts/cloud-server.js",
    "lint": "npx @biomejs/biome check --use-editorconfig=true plugin/ public/ components/ lib/ scripts/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write plugin/ public/ components/ test/ lib/ scripts/",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/meri-imperiumi/offshore-blogging-system.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-weather",
    "signalk-webapp",
    "inreach",
    "offshore",
    "blogging"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "signalk": {
    "appIcon": "./icon-256.png",
    "displayName": "Offshore Blogging",
    "screenshots": [
      "./doc/weather-request.jpg",
      "./doc/download-grib.jpg"
    ],
    "recommends": [
      "signalk-grib-weather-provider"
    ]
  },
  "dependencies": {
    "@reticulum/core": "^0.10.0",
    "@reticulum/dacar": "^1.7.0",
    "imapflow": "^1.6.6",
    "@noflo/noflo": "^2.0.0-alpha.14",
    "@noflo/assembly": "^2.0.0-alpha.14",
    "@noflo/core": "^2.0.0-alpha.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@noflo/loader-node": "^2.0.0-alpha.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
