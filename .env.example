# Cloud server environment — copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# --- IMAP (receive InReach / Saildocs email) ---
# Host/port are used by the test runners only; the production cloud-server
# graph fixes imap.mailbox.org:993 as literals (SPEC.md) and ignores these.
IMAP_HOST=imap.mailbox.org
IMAP_PORT=993
IMAP_USERNAME=boat@example.com
IMAP_PASSWORD=
# Mailbox to poll (runners only, default INBOX)
# IMAP_MAILBOX=INBOX

# --- SMTP (send replies, Saildocs requests) ---
# Host/port are used by the test runners only; SmtpResponder in the
# production graph defaults to smtp.mailbox.org.
SMTP_HOST=smtp.mailbox.org
SMTP_PORT=465
SMTP_USERNAME=boat@example.com
SMTP_PASSWORD=

# --- Blog repo ---
REPO_PATH=/home/boat/blog-repo

# --- Cloud SQLite file (created on first run) ---
CLOUD_DB_PATH=/home/boat/.offshore-blogging/cloud.db

# --- InReach reply / operator alerting ---
INREACH_REPLY_ADDRESS=cloud@example.com
ALERT_ADDRESS=operator@example.com

# --- Error log ---
LOG_PATH=/home/boat/.offshore-blogging/errors.log

# --- Optional: override the graph path (default graphs/cloud-server.fbp) ---
# CLOUD_GRAPH=./graphs/cloud-server.fbp

# --- Dacar authorization store (operator bootstraps via the `dacar` CLI) ---
# Default if unset: ~/.dacar . See cloud.md §7 and `dacar init` / `dacar grant`.
DACAR_HOME=/home/boat/.dacar
# Optional: explicit `dacar` binary path if not on PATH.
# DACAR_BIN=/usr/local/bin/dacar

# --- Device mapping (ping-pong TESTING ONLY; do NOT set in production) ---
# AuthVerifier uses these instead of the inreach_devices SQLite table.
# TEST_DEVICE_ID=
# TEST_IMEI=
# TEST_IDENTITY_HASH=
