# Cloud Server Graph for offshore blogging system
# Routes emails from InReach/Winlink to appropriate handlers
#
# Deployment config (credentials, paths) is read from environment variables
# via core/ReadEnv so the graph carries no secrets. Required env vars:
#
#   IMAP_USERNAME, IMAP_PASSWORD         mailbox.org IMAP creds (Listener + Acker)
#   SMTP_USERNAME, SMTP_PASSWORD         mailbox.org SMTP creds (SmtpResponder)
#   CLOUD_DB_PATH                         shared SQLite file for all DB components
#   REPO_PATH                             local clone of the blog repo
#   INREACH_REPLY_ADDRESS                 cloud address shown to InReach recipients
#   ALERT_ADDRESS                         operator address for unrecoverable alerts
#   LOG_PATH                              ErrorLogger log file
#   DACAR_HOME                            dacar CLI store path (default ~/.dacar);
#                                        read via a core/ReadEnv node (DacarEnv)
#                                        and fed to DacarAuthorizer's STORE inport.
#                                        Unset → the `dacar` CLI resolves its own
#                                        default (same path the operator's
#                                        `dacar grant` uses).
#
# Provider identity (mailbox.org) is fixed by SPEC.md and wired as literals.
#
# Provider identity (mailbox.org) is fixed by SPEC.md and wired as literals.
# Timer intervals: PollTimer 60s, NackTimer 15m.

# 0. Deployment config via environment (fan out to the components that need each)
'IMAP_USERNAME' -> KEY ImapUserEnv(core/ReadEnv)
ImapUserEnv OUT -> USERNAME Listener
ImapUserEnv OUT -> USERNAME ImapAcker

'IMAP_PASSWORD' -> KEY ImapPassEnv(core/ReadEnv)
ImapPassEnv OUT -> PASSWORD Listener
ImapPassEnv OUT -> PASSWORD ImapAcker

'SMTP_USERNAME' -> KEY SmtpUserEnv(core/ReadEnv)
SmtpUserEnv OUT -> SMTP_USER SmtpResponder

'SMTP_PASSWORD' -> KEY SmtpPassEnv(core/ReadEnv)
SmtpPassEnv OUT -> SMTP_PASS SmtpResponder

'CLOUD_DB_PATH' -> KEY DbEnv(core/ReadEnv)
# DacarAuthorizer instances (BlogAuth, GribAuth, SysAuth) do NOT take a
# dbpath: they evaluate via the `dacar` CLI against the file store at
# $DACAR_HOME (default ~/.dacar), the same store the operator manages with
# `dacar init`/`dacar grant`/`dacar sync`. The store path flows in on the
# `STORE` inport from the DacarEnv ReadEnv node above; a grant made after the
# server started is picked up on the next message — no restart needed.
DbEnv OUT -> DBPATH Verifier
DbEnv OUT -> DBPATH GribFetcher
DbEnv OUT -> DBPATH Gate
DbEnv OUT -> DBPATH Reassembler
DbEnv OUT -> DBPATH SaildocsMatcher
DbEnv OUT -> DBPATH StatusBuilder

'REPO_PATH' -> KEY RepoEnv(core/ReadEnv)
RepoEnv OUT -> REPO_PATH GitPublisher
# Hi-fi sync happens on the boat (rngit mirror / backup.sh pushes hi-fi
# straight to GitHub); the cloud just pulls from GitHub before writing each
# lo-fi post and pushes the result (GitPublisher does both). No periodic
# boat->cloud sync, no separate pusher component.

'INREACH_REPLY_ADDRESS' -> KEY InReachReplyEnv(core/ReadEnv)
InReachReplyEnv OUT -> REPLYADDRESS InReachSender

'ALERT_ADDRESS' -> KEY AlertEnv(core/ReadEnv)
AlertEnv OUT -> ALERTADDRESS AlertComposer

'LOG_PATH' -> KEY LogEnv(core/ReadEnv)
LogEnv OUT -> LOGPATH ErrorLogger

# Dacar authorization store path. Read via core/ReadEnv (same idiom as
# CLOUD_DB_PATH / REPO_PATH) so the graph carries no hidden env reads. When
# DACAR_HOME is unset, ReadEnv sends nothing on OUT and DacarAuthorizer omits
# `--store`, letting the `dacar` CLI resolve its own default (~/.dacar) —
# the same resolution the operator's `dacar grant` uses, so they can't diverge.
'DACAR_HOME' -> KEY DacarEnv(core/ReadEnv)
DacarEnv OUT -> STORE BlogAuth
DacarEnv OUT -> STORE GribAuth
DacarEnv OUT -> STORE SysAuth

# 1. IMAP Ingestion & Authentication
# PollTimer drives a one-shot fetch cycle (open, fetch unseen, close) every
# 60s. The runners wire the same RunInterval→Fetcher.in trigger; the
# production graph previously had none, so it never polled.
'start' -> START PollTimer(core/RunInterval)
60000 -> INTERVAL PollTimer
PollTimer OUT -> IN Listener(ImapFetcher)
'imap.mailbox.org' -> HOST Listener
'993' -> PORT Listener
# ImapAcker needs the same IMAP host/port as the fetcher (it connects to
# mark messages seen after the reply is sent).
'imap.mailbox.org' -> HOST ImapAcker(ImapAcker)
'993' -> PORT ImapAcker
Listener OUT -> IN Verifier(AuthVerifier)

# 1b. Parse Winlink blog posts before InReachReceiver
Verifier OUT -> IN WinlinkBlogReceiver(WinlinkBlogReceiver)

# 1b. Parse InReach lo-fi chunk headers before reassembly. (Winlink
# blog posts and Saildocs replies carry no lo-fi header and pass straight
# through InReachReceiver unchanged.)
WinlinkBlogReceiver OUT -> IN Receiver(InReachReceiver)

# 2. Upstream Reassembly (Stateful Buffer & NACK engine)
# core/RunInterval (NOT core/Ticker, which doesn't exist) fires every 15m,
# driving MessageReassembler's CHECK port to NACK missing chunks.
'start' -> START NackTimer(core/RunInterval)
900000 -> INTERVAL NackTimer
NackTimer OUT -> CHECK Reassembler(MessageReassembler)
Receiver OUT -> IN Reassembler

# 3. Intent Routing (array port)
'BLOG,GRIB,SAILDOCS,SYS,NOTIFY' -> ROUTES Router(ParserRouter)
Reassembler OUT -> IN Router

# Router ERROR handles failed(msg) IPs - replies to sender
Router ERROR -> IN ReplyDispatcher(ReplyDispatcher)

# ReplyDispatcher routes failed messages to SMTP (ErrorLogger checks failed(msg))
ReplyDispatcher SMTP -> IN ErrorLogger(ErrorLogger)
Router MISSED -> IN ErrorLogger(ErrorLogger)
# ReplyDispatcher also routes its failed messages to ErrorLogger
ReplyDispatcher SMTP -> IN ErrorLogger(ErrorLogger)

# 4. Application Logic: Blog Pipeline
'blog:publish' -> PERMISSION BlogAuth(DacarAuthorizer)
Router OUT[0] -> IN BlogAuth
BlogAuth DENIED -> IN ReplyDispatcher

# BlogAuth output goes to DecoderBypass which checks if already decoded
# (Winlink) or needs decompression (InReach)
BlogAuth OUT -> IN DecoderBypass(DecoderBypass)
DecoderBypass OUT -> IN BlogDecoder(BlogDecoder)
DecoderBypass BYPASS -> IN GitPublisher(GitPublisher)
BlogAuth DENIED -> IN AlertComposer(AlertComposer)
# BlogDecoder OUT (decoded from InReach chunks) goes to GitPublisher.
# Failed messages pass through GitPublisher (validate() fails) to ReplyDispatcher.
BlogDecoder OUT -> IN GitPublisher
GitPublisher OUT -> IN ReplyDispatcher

# 5. Application Logic: GRIB Weather Pipeline
'grib:request' -> PERMISSION GribAuth(DacarAuthorizer)
Router OUT[1] -> IN GribAuth
GribAuth DENIED -> IN ReplyDispatcher

GribAuth OUT -> IN GribFetcher(GribFetcher)
GribFetcher DIRECT -> IN GribChunker(GribChunker)
# GribFetcher OUTBOX goes to SMTP regardless of channel (new outbound request to Saildocs)
GribFetcher OUTBOX -> IN SmtpResponder(SmtpResponder)
# Ack the original InReach/Winalert request email only AFTER the SMTP send
# to Saildocs succeeds (SmtpResponder OUT → ImapAcker). If SMTP fails, the
# email stays unseen and is re-fetched on the next poll, retrying the
# request. For a driving-blind user it is safer to send twice than to ack
# early and silently lose the request when SMTP fails.
SmtpResponder OUT -> IN ImapAcker(ImapAcker)

# 6. Third-Party Bridge (Saildocs Ingestion)
Router OUT[2] -> IN SaildocsMatcher(SaildocsMatcher)
# GRIB responses go via DIRECT (→ GribChunker → Gate → delivery). Sending
# on OUT too would double-deliver the raw GRIB buffer alongside the chunks.
SaildocsMatcher DIRECT -> IN GribChunker(GribChunker)
# Error responses (no GRIB attachment — e.g. Saildocs "HTTP 405" /
# "command error" replies) go via OUT as NOTIFY text straight to the user,
# bypassing GribChunker. The user is driving blind — an error message is
# better than a silent drop, and it prevents the email from looping unseen.
SaildocsMatcher OUT -> IN ReplyDispatcher(ReplyDispatcher)
ReplyDispatcher SMTP -> IN ImapAcker(ImapAcker)
ReplyDispatcher INREACH -> IN ImapAcker(ImapAcker)

# 7. System Commands & The GRIB Gatekeeper
'sys:command' -> PERMISSION SysAuth(DacarAuthorizer)
Router OUT[3] -> IN SysAuth
SysAuth DENIED -> IN ReplyDispatcher

SysAuth OUT -> IN CmdRouter(CommandRouter)
'GATE,STATUS,PING' -> ROUTES CmdRouter
CmdRouter OUT[0] -> COMMAND Gate(GribGate)
CmdRouter OUT[1] -> IN StatusBuilder(StatusBuilder)
CmdRouter OUT[2] -> IN PingHandler(PingHandler)
PingHandler OUT -> IN ReplyDispatcher
CmdRouter MISSED -> IN ErrorLogger

GribChunker OUT -> IN Gate
# If the payload is small (<= N chunks) or user sends "YES", Gate releases it here:
Gate OUT -> IN ReplyDispatcher
# If the payload is too large (> N chunks), Gate holds it and routes a NOTIFY message back:
Gate NOTIFY -> IN ReplyDispatcher

StatusBuilder OUT -> IN ReplyDispatcher

# 8. Feedback Loop / Notifications (CANCEL confirmations, etc.)
Router OUT[4] -> IN ReplyDispatcher

# 9. Channel-aware reply delivery
ReplyDispatcher SMTP -> IN SmtpResponder(SmtpResponder)
ReplyDispatcher INREACH -> IN InReachSender(InReachSender)

# 9b. InReach failure handling: log every failure (file record via
# ErrorLogger) AND alert the operator out-of-band for
# unrecoverable ones (dead reply channel / bad config). The alert goes via
# SMTP through SmtpResponder, never back through InReachSender (cloud.md's
# "not itself routed through this same component" rule). AlertComposer is
# rate-limited (max one per error code per hour) and filters to unrecoverable
# codes only; transient failures (rate limit, network) are logged but not
# paged. alertaddress is deployment config (set at runtime, like smtp creds).
# InReachSender now follows noflo-assembly pattern: failed messages go
# through the out port, not a dedicated error port.
InReachSender OUT -> IN ErrorLogger(ErrorLogger)
InReachSender OUT -> IN AlertComposer(AlertComposer)
AlertComposer OUT -> IN SmtpResponder

# 10. (removed) Periodic Hi-Fi Sync — no longer needed in the cloud. Hi-fi
# assets are merged on the boat itself (rngit mirror / backup.sh pulls from
# GitHub, writes the hi-fi files, and pushes back to GitHub) and that is
# already implemented and running. The cloud's only git job is per-blog-post:
# GitPublisher pulls from GitHub (latest state, incl. any hi-fi the boat
# pushed), writes the lo-fi post, commits, and pushes — all inline, no timer.
